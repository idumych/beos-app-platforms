# haiku-app.env — what the beos-app-platforms release tools need to know about this app.
# Shell syntax: sourced by packaging/*.sh, the CI workflow and the
# release scripts (check-artifact.sh, release-gate.sh). Keep values quoted; no spaces around '='.

# ── Identity ──
APP_NAME="MyApp"                       # binary name = window/team name, e.g. Meshy
APP_CMD="myapp"                        # package name and command, lowercase
APP_SIG="application/x-vnd.MyName-MyApp"   # must equal the .rdef app_signature
RDEF="MyApp.rdef"                      # path of the resource definition

PLATFORMS="haiku linux"                # what ships: "haiku linux", or "linux" for a
                                       # Linux-only port (no .hpkg; the gate skips Haiku)

# ── Version (also in the .rdef app_version) ──
VERSION="0.1.0"
REVISION="1"

# ── Package metadata ──
SUMMARY="One line, no trailing period"
DESCRIPTION_FILE="packaging/description.txt"   # plain text; blank line = paragraph
HOMEPAGE="https://github.com/OWNER/REPO"
GITHUB_REPO="OWNER/REPO"
LICENSE_NAME="MIT"                     # a name from /boot/system/data/licenses on Haiku
                                       # (GNU GPL v3, MIT, BSD (3-clause), ...)
COPYRIGHT="2026 the MyApp contributors"
PACKAGER="Name <email@example.com>"

# Extra runtime dependencies beyond the Haiku API itself
HPKG_REQUIRES_EXTRA=""                 # e.g. "lib:libsqlite3 lib:libcrypto"
DESKTOP_CATEGORIES="Utility;"          # freedesktop categories for the AppImage
APPIMAGE_MUST_BUNDLE=""                # libs check-artifact.sh must find bundled,
                                       # e.g. "libsqlite3 libcrypto"
APPIMAGE_FONTS_EXTRA=""                # fonts the app selects by family, bundled in the
                                       # AppImage, e.g. "NotoSerif-Regular NotoSerif-Bold"
APPIMAGE_TRANSLATORS="PNG"             # image translators the AppImage bundles, the ones the
                                       # app reads or writes through the Translation Kit
                                       # (BMP GIF HVIF ICNS ICO JPEG PNG PPM RAW STXT TGA TIFF
                                       # WebP). Each pulls in its codec library (RAW: libraw,
                                       # libgomp; TIFF: libtiff...). "" = none; delete the
                                       # line to bundle all of them
COSMOE_REPO=""                         # "" = idumych/hokku, the Cosmoe fork the AppImage is
                                       # built with; set it only to try another (upstream:
                                       # haydentech/cosmoe)
COSMOE_TAG=""                          # its tag or branch ("" = hokku)
SMOKE_ARGS=""                          # arguments the CI smoke tests start the app with,
                                       # e.g. "127.0.0.1" so a network client doesn't
                                       # connect to a public server ("" = none)
APPIMAGE_APT_EXTRA=""                  # extra Ubuntu 24.04 -dev packages the AppImage CI
                                       # needs, e.g. "libsqlite3-dev libssl-dev"

# ── Build ──
HPKG_BUILD_DEPS=""                     # Haiku -devel packages the build needs,
                                       # e.g. "sqlite_devel openssl3_devel"
TEST_CMD=""                            # host-side unit tests, e.g. "make test"; "" if none
TYPECHECK_SRCS=""                      # Haiku-API .cpp files for tools/haiku-typecheck.sh
TYPECHECK_INCLUDES=""                  # extra -I dirs for it, e.g. "src/core src/ui"
TYPECHECK_CXXFLAGS=""                  # extra flags for it: the app's -D defines, and
                                       # -D__HAIKU__ if its code tests for Haiku

# ── Feature test (the app-specific part of release/test-plan.md) ──
# Check names the platform evidence must mark PASS, besides the standard
# install attrs launch log-clean quit:
FEATURE_CHECKS="feature1"
# Raw evidence the gate verifies itself. "FILE|REGEX": FILE is relative to
# dist/<VERSION>/evidence, REGEX a grep -E pattern; {p} is replaced by the
# platform (haiku, linux). Number them EVIDENCE_1, EVIDENCE_2, ...
EVIDENCE_1="{p}-screen.txt|SomeTextTheFeatureShows"
